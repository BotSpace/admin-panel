# Botmother Admin Panel - Environment Variables
# Copy this file to .env.local and fill in the values

# Debug Mode
# Set to "true" to enable debug mode, "false" to disable
# Default: "false"
DEBUG=true

# Google Oauth
GOOGLE_CLIENT_ID=1
GOOGLE_CLIENT_SECRET=1

# API Configuration
# Backend API base URL (required)
# Example: https://api.botmother.uz
NEXT_PUBLIC_API=https://api.botmother.uz

# Constructor URL
# URL for the bot constructor service (required)
# Example: https://constructor.botmother.uz
CONSTRUCTOR_URL=http://localhost:3001

# Sales URL
# URL for the sales/website service (required)
# Example: https://sales.botmother.uz
SALES_URL=http://localhost:3002

# NextAuth Configuration
# Secret key for NextAuth.js (required, minimum 32 characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="C^%&RTG*H*(JYW9yj7x9wh9J!@^TYs871901-2jie)"

# NextAuth URL
# The canonical URL of your site for NextAuth.js
# Example: https://admin.botmother.uz
# For local development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Server Port
# Port number for the application server
# Default: 3000
PORT=3000

# Node Environment
# Set to "development", "production", or "test"
# Default: "development"
NODE_ENV=development
